# Public configuration only; starter shell does not connect to a game server yet.
VITE_GAME_SERVER_URL=http://localhost:2567
VITE_ENABLE_VOICE=false
# Proposed server settings; server implementation must explicitly read/validate these.
PORT=2567
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost
# Server-only future voice credentials. Never prefix these secrets with VITE_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Supabase adapter implementation required; public configuration only in VITE fields.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key, only if needed for server writes.
SUPABASE_SECRET_KEY=
# Deployed builds must fail closed; local bypass is an explicit development setting.
ALLOW_LOCAL_GUESTS=false
# Cloud Run injects PORT. Do not hardcode port 2567 in the server.
