{
  "name": "synccity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SyncCity build preparation kit and web shell; gameplay implementation pending",
  "workspaces": ["apps/web", "apps/server", "packages/shared"],
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server:dev": "tsx apps/server/src/index.ts",
    "server:test": "tsx --test apps/server/test/invariants.test.ts",
    "test": "npm run server:test",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "ios:add": "cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
